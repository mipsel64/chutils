<!-- Pin the `default` user to no password and full network access for the
     integration-test ClickHouse instance spun up by docker-compose.yml.
     Overrides anything baked into the image so repeated up/down cycles
     (which retain the anonymous data volume) can't leave stale auth state. -->
<clickhouse>
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </default>
    </users>
</clickhouse>
